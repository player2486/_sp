// 14_prime.m0 - 質數判斷
func is_prime(n) {
    if (n < 2) {
        return false;
    }
    for (i = 2; i * i <= n; i = i + 1) {
        if (n % i == 0) {
            return false;
        }
    }
    return true;
}

count = 0;
n = 2;
while (count < 20) {
    if (is_prime(n)) {
        print("prime: ", n);
        count = count + 1;
    }
    n = n + 1;
}
