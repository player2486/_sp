// 11_sort.m0 - 泡沫排序
func sort(arr, n) {
    for (i = 0; i < n - 1; i = i + 1) {
        for (j = 0; j < n - i - 1; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

data = [64, 34, 25, 12, 22, 11, 90];
print("Before sorting:");
print(data);

sort(data, 7);

print("After sorting:");
print(data);
