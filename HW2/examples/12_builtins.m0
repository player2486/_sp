// 12_builtins.m0 - 內建函式測試
// 型別檢查
print(type(42));
print(type("hello"));
print(type(true));
print(type(nil));
print(type([1, 2, 3]));
print(type({a: 1}));

// 數學函式
print("abs(-5) = ", abs(-5));
print("sqrt(16) = ", sqrt(16));
print("floor(3.7) = ", floor(3.7));
print("ceil(3.2) = ", ceil(3.2));

// 型別轉換
print("int(", "42", ") = ", int("42"));
print("float(", "3.14", ") = ", float("3.14"));
print("str(", 123, ") = ", str(123));

// len
print("len('hello') = ", len("hello"));
print("len([1,2,3]) = ", len([1, 2, 3]));
